# === LLM 配置（复制本文件为 .env 后填写真实值） ===

# 必填：模型名称与 API Key（config.py 启动时校验，缺失会直接报错）
MODEL_NAME="deepseek-flash"
OPENAI_API_KEY="你的 API Key"

# 可选：兼容 OpenAI 协议的 API 地址（默认 OpenAI 官方）
# 用 DeepSeek / 硅基流动等时取消注释：
BASE_URL="https://api.deepseek.com/v1"

# 可选：多 Key 轮换（config.py 自动收集，限流时依次切换）
# OPENAI_API_KEY_2="第二个 Key"
# OPENAI_API_KEY_3="第三个 Key"

# 可选：LangSmith 链路追踪（调试用，平时建议关闭避免刷屏）
# LANGSMITH_API_KEY="lsv2-..."
# LANGSMITH_TRACING=false

# 可选：项目根目录（当前代码未读取，仅为记录）
# PROJECT_ROOT=C:\path\to\Myone_agent1
